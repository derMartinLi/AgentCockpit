# Copy to backend/.env and set the Provider API Key used by Agent Cockpit.
AGENT_COCKPIT_API_KEY=
AGENT_COCKPIT_MAX_CONCURRENT_RUNS=3

# Optional Langfuse tracing. Both keys are required when tracing is enabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
AGENT_COCKPIT_LANGFUSE_ENABLED=true
AGENT_COCKPIT_LANGFUSE_ENVIRONMENT=development
